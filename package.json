{
  "name": "dragon-miner-game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:admin": "vite --mode admin",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "build:admin": "npm run typecheck && vite build --mode admin",
    "build:tudo": "npm run build && npm run build:admin",
    "serve:build": "bash tools/serve-preview.sh 4173 --page jogo",
    "serve:build:teste": "bash tools/serve-preview.sh 4174 --page teste",
    "serve:build:admin": "bash tools/serve-preview.sh 4175 --admin --page teste",
    "preview": "vite preview",
    "preview:admin": "vite preview --mode admin",
    "test": "vitest run",
    "test:painel": "node tools/teste-page-smoke.mjs dist",
    "validate:warrior-glb": "node scripts/validate-warrior-glb.mjs public/models/Guerreiro/guerreiro_animado.glb"
  },
  "dependencies": {
    "three": "^0.161.0"
  },
  "devDependencies": {
    "@types/three": "^0.185.4",
    "happy-dom": "^20.14.0",
    "typescript": "^5.4.0",
    "vite": "^5.1.0",
    "vitest": "^4.1.11"
  }
}
